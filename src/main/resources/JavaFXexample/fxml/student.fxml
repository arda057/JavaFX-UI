<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="740.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="JavaFXexample.controller.StudentController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <VBox maxHeight="1.7976931348623157E308" maxWidth="860.0" spacing="16.0" styleClass="card">
         <children>
            <!-- Header Toolbar -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#returnDashboard" styleClass="btn-secondary" text="← Dashboard" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label alignment="TOP_LEFT" styleClass="title" text="Student Records Directory" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="addButton" mnemonicParsing="false" onAction="#addStudent" styleClass="btn-success" text="+ Add New Student" />
                  <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#deleteStudent" styleClass="btn-danger" text="🗑 Delete Selected" />
               </children>
            </HBox>
            
            <!-- Table View -->
            <TableView fx:id="studentTable" editable="true" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="idColumn" minWidth="60.0" prefWidth="80.0" text="Student ID" />
                <TableColumn fx:id="nameColumn" minWidth="150.0" prefWidth="240.0" text="Full Name" />
                <TableColumn fx:id="gpaColumn" minWidth="80.0" prefWidth="100.0" text="GPA" />
                <TableColumn fx:id="departmentColumn" minWidth="150.0" prefWidth="240.0" text="Department" />
                <TableColumn fx:id="actionColumn" maxWidth="80.0" minWidth="80.0" resizable="false" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            
            <!-- Search & Filter Controls -->
            <VBox spacing="8.0">
               <children>
                  <Label styleClass="form-label" text="🔍 Live Search &amp; Filter By Fields:" />
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <TextField fx:id="idField" promptText="Filter by ID" styleClass="field" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="nameField" promptText="Filter by Name" styleClass="field" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="gpaField" promptText="Filter by GPA" styleClass="field" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="departmentField" editable="true" maxWidth="200.0" promptText="Filter by Department" HBox.hgrow="ALWAYS" />
                        <Button alignment="CENTER" minWidth="-Infinity" mnemonicParsing="false" onAction="#clearForm" styleClass="btn-secondary" text="Clear Filter" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
         </padding>
      </VBox>
      <ProgressIndicator fx:id="loadingIndicator" maxHeight="56.0" maxWidth="56.0" mouseTransparent="true" visible="false" />
   </children>
</StackPane>
