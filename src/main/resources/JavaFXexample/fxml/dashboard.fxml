<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="840.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="JavaFXexample.controller.DashboardController">
   <children>
      <VBox alignment="TOP_CENTER" maxHeight="520.0" maxWidth="640.0" prefHeight="520.0" prefWidth="640.0" spacing="5.0" styleClass="card">
         <children>
            <ImageView fitHeight="100.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/sms.png" />
               </image>
            </ImageView>
            <VBox spacing="20.0">
               <children>
                  <!-- User Header Area -->
                  <HBox alignment="CENTER_LEFT" spacing="20.0">
                     <children>
                        <ImageView fx:id="profilePhoto" fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" styleClass="profile-picture">
                           <image>
                              <Image url="@../images/blankprofilepicture.jpg" />
                           </image>
                        </ImageView>
                        <VBox alignment="CENTER_LEFT" spacing="3.0">
                           <children>
                              <Label styleClass="title" text="Student Management Dashboard" />
                              <Label fx:id="welcomeLabel" styleClass="subtitle" text="Welcome back!">
                                 <font>
                                    <Font size="16.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="6.0" left="10.0" right="10.0" top="6.0" />
                     </padding>
                  </HBox>
                  
                  <!-- Main Actions: Student Table & Curriculum -->
                  <VBox spacing="10.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#studentTable" styleClass="dashboard-main-btn" text="🎓  Open Student Records Table" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#curriculum" styleClass="dashboard-main-btn" text="📚  Department Curriculum" />
                     </children>
                  </VBox>
                  
                  <!-- Secondary Actions: Settings & Logout -->
                  <HBox alignment="CENTER" spacing="16.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" minHeight="45.0" mnemonicParsing="false" onAction="#profileSettings" styleClass="dashboard-button" text="⚙️  Profile Settings" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="1.7976931348623157E308" minHeight="45.0" mnemonicParsing="false" onAction="#logout" styleClass="dashboard-danger-btn" text="🚪  Logout" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="32.0" left="40.0" right="40.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</StackPane>
