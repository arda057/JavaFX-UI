<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="760.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="JavaFXexample.controller.CurriculumController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <children>
      <VBox maxHeight="1.7976931348623157E308" maxWidth="1040.0" spacing="14.0" styleClass="card">
         <children>
            <!-- Header Toolbar -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#returnDashboard" styleClass="btn-secondary" text="← Dashboard" />
                  <Label styleClass="title" text="Academic Curriculum Directory" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label styleClass="field-label" text="Department:" />
                  <ComboBox fx:id="departmentComboBox" prefWidth="250.0" promptText="Select Department" />
                  <TextField fx:id="searchField" prefWidth="180.0" promptText="🔍 Filter courses..." styleClass="field" />
                  <Button mnemonicParsing="false" onAction="#addCourse" styleClass="btn-success" text="+ Add Course" />
               </children>
            </HBox>
            
            <!-- Sub-Header & Stats Bar -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Label fx:id="departmentTitleLabel" text="Department Curriculum">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="totalCoursesLabel" styleClass="schedule-pill" text="Total Courses: 0" />
                  <Label fx:id="totalCreditsLabel" styleClass="schedule-pill" text="Total Credits: 0" />
                  <Label fx:id="totalEctsLabel" styleClass="schedule-pill-term" text="Total ECTS: 0" />
               </children>
               <padding>
                  <Insets bottom="2.0" top="2.0" />
               </padding>
            </HBox>

            <!-- Main TabPane for Years & Overview -->
            <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
               <tabs>
                  <!-- Year 1 Tab -->
                  <Tab text="Year 1 (Freshman)">
                     <content>
                        <HBox spacing="14.0">
                           <children>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                       <children>
                                          <Label styleClass="form-label" text="🍂 Semester 1 (Fall)" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="labelY1S1Stats" styleClass="detail-label-header" text="0 Courses • 0 Credits • 0 ECTS" />
                                       </children>
                                    </HBox>
                                    <TableView fx:id="tableY1S1" VBox.vgrow="ALWAYS" />
                                 </children>
                              </VBox>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                       <children>
                                          <Label styleClass="form-label" text="🌸 Semester 2 (Spring)" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="labelY1S2Stats" styleClass="detail-label-header" text="0 Courses • 0 Credits • 0 ECTS" />
                                       </children>
                                    </HBox>
                                    <TableView fx:id="tableY1S2" VBox.vgrow="ALWAYS" />
                                 </children>
                              </VBox>
                           </children>
                           <padding>
                              <Insets bottom="6.0" left="6.0" right="6.0" top="10.0" />
                           </padding>
                        </HBox>
                     </content>
                  </Tab>

                  <!-- Year 2 Tab -->
                  <Tab text="Year 2 (Sophomore)">
                     <content>
                        <HBox spacing="14.0">
                           <children>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                       <children>
                                          <Label styleClass="form-label" text="🍂 Semester 1 (Fall)" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="labelY2S1Stats" styleClass="detail-label-header" text="0 Courses • 0 Credits • 0 ECTS" />
                                       </children>
                                    </HBox>
                                    <TableView fx:id="tableY2S1" VBox.vgrow="ALWAYS" />
                                 </children>
                              </VBox>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                       <children>
                                          <Label styleClass="form-label" text="🌸 Semester 2 (Spring)" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="labelY2S2Stats" styleClass="detail-label-header" text="0 Courses • 0 Credits • 0 ECTS" />
                                       </children>
                                    </HBox>
                                    <TableView fx:id="tableY2S2" VBox.vgrow="ALWAYS" />
                                 </children>
                              </VBox>
                           </children>
                           <padding>
                              <Insets bottom="6.0" left="6.0" right="6.0" top="10.0" />
                           </padding>
                        </HBox>
                     </content>
                  </Tab>

                  <!-- Year 3 Tab -->
                  <Tab text="Year 3 (Junior)">
                     <content>
                        <HBox spacing="14.0">
                           <children>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                       <children>
                                          <Label styleClass="form-label" text="🍂 Semester 1 (Fall)" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="labelY3S1Stats" styleClass="detail-label-header" text="0 Courses • 0 Credits • 0 ECTS" />
                                       </children>
                                    </HBox>
                                    <TableView fx:id="tableY3S1" VBox.vgrow="ALWAYS" />
                                 </children>
                              </VBox>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                       <children>
                                          <Label styleClass="form-label" text="🌸 Semester 2 (Spring)" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="labelY3S2Stats" styleClass="detail-label-header" text="0 Courses • 0 Credits • 0 ECTS" />
                                       </children>
                                    </HBox>
                                    <TableView fx:id="tableY3S2" VBox.vgrow="ALWAYS" />
                                 </children>
                              </VBox>
                           </children>
                           <padding>
                              <Insets bottom="6.0" left="6.0" right="6.0" top="10.0" />
                           </padding>
                        </HBox>
                     </content>
                  </Tab>

                  <!-- Year 4 Tab -->
                  <Tab text="Year 4 (Senior)">
                     <content>
                        <HBox spacing="14.0">
                           <children>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                       <children>
                                          <Label styleClass="form-label" text="🍂 Semester 1 (Fall)" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="labelY4S1Stats" styleClass="detail-label-header" text="0 Courses • 0 Credits • 0 ECTS" />
                                       </children>
                                    </HBox>
                                    <TableView fx:id="tableY4S1" VBox.vgrow="ALWAYS" />
                                 </children>
                              </VBox>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                       <children>
                                          <Label styleClass="form-label" text="🌸 Semester 2 (Spring)" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="labelY4S2Stats" styleClass="detail-label-header" text="0 Courses • 0 Credits • 0 ECTS" />
                                       </children>
                                    </HBox>
                                    <TableView fx:id="tableY4S2" VBox.vgrow="ALWAYS" />
                                 </children>
                              </VBox>
                           </children>
                           <padding>
                              <Insets bottom="6.0" left="6.0" right="6.0" top="10.0" />
                           </padding>
                        </HBox>
                     </content>
                  </Tab>

                  <!-- All Courses Overview Tab -->
                  <Tab text="All Courses Overview">
                     <content>
                        <VBox spacing="8.0">
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label styleClass="form-label" text="📋 Complete Department Curriculum Directory" />
                                 </children>
                              </HBox>
                              <TableView fx:id="tableAll" VBox.vgrow="ALWAYS" />
                           </children>
                           <padding>
                              <Insets bottom="6.0" left="6.0" right="6.0" top="10.0" />
                           </padding>
                        </VBox>
                     </content>
                  </Tab>
               </tabs>
            </TabPane>
         </children>
         <padding>
            <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
         </padding>
      </VBox>
      <ProgressIndicator fx:id="loadingIndicator" maxHeight="56.0" maxWidth="56.0" mouseTransparent="true" visible="false" />
   </children>
</StackPane>
